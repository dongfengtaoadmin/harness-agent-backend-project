# 运行环境：development / production
APP_ENV=development

# 必填：数据库连接串（敏感信息）
MYSQL_URL="mysql+pymysql://root:a1994*@localhost:3306/agent_project_database"


# JWT 签名密钥，用于生成和验证令牌，可根据实际情况修改。
JWT_SECRET="dev_change_me_please"
# JWT 签名算法，例如 HS256等。
JWT_ALGORITHM="HS256"
# Access Token 的有效期（分钟）
JWT_ACCESS_EXPIRE_MINUTES=120
# Refresh Token 的有效期（分钟）。通常设置较长，如 7 天 (10080 分钟)。
JWT_REFRESH_EXPIRE_MINUTES=10080


# MinIO核心配置（app/core/settings.py）
MINIO_ENDPOINT = "127.0.0.1:9000"
MINIO_ACCESS_KEY = "minioadmin"
MINIO_SECRET_KEY = "minioadmin"
MINIO_BUCKET = "ai-resources"
MINIO_SECURE = False  # 本地关闭HTTPS

# OpenAI 兼容接口（如 DeepSeek）：必填密钥，否则流式对话无法调用模型
DEEPSEEK_API_KEY=sk-9ec1d734912d48ce219780dc45578
# 以下为可选；不填则使用代码内默认值
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=1024

# GLM-5（腾讯云 Coding Plan Anthropic 兼容接口）
ANTHROPIC_AUTH_TOKEN=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/anthropic
ANTHROPIC_MODEL=glm-5

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# # 阿里百炼千问模型秘钥
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant 向量数据库（地址跨环境会变；collection 名作为代码常量）
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 火山引擎模型秘钥
